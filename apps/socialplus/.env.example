# A copier vers .env.local ; ne jamais versionner les valeurs personnelles.
# npm run owner initialise ID + TOTP et demande email/mot de passe dans le terminal.
SOCIALPLUS_ORIGIN=http://localhost:4318
SOCIALPLUS_HOST=127.0.0.1
PORT=4318
SOCIALPLUS_DATA_DIR=.data
SOCIALPLUS_OWNER_ID=
SOCIALPLUS_OWNER_TOTP_SECRET=
SOCIALPLUS_MAX_RENDERS_PER_DAY=10
# Python avec numpy et Pillow pour les composants originaux restaurés.
# Sous Windows, utiliser python (ou le chemin absolu vers python.exe).
SOCIALPLUS_PYTHON=python3

# Laisser le laboratoire artistique desactive sans sources/preuves de QA.
# SOCIALPLUS_BETA_RENDER=staging

# Documents publics : statut brouillon tant que ces champs/revue manquent.
SOCIALPLUS_LEGAL_NAME=
SOCIALPLUS_LEGAL_ADDRESS=
SOCIALPLUS_LEGAL_CONTACT=
SOCIALPLUS_LEGAL_HOST=
SOCIALPLUS_LEGAL_REVIEWED=false
