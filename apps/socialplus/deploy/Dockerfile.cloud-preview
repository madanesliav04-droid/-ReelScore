# syntax=docker/dockerfile:1
# Build from repository root using the adjacent explicit runtime allowlist.
# No deployment, user media or credentials are included in this image.
FROM node:24-bookworm-slim
WORKDIR /app/apps/socialplus
COPY --chown=node:node . /app
# One installation layer avoids copying the complete media runtime repeatedly
# on disk-constrained builders. The optional CA is only a build-time mount.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca PIP_CERT=/run/secrets/proxy_ca; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates python3 python3-venv python3-pip python3-numpy python3-pil chromium \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/socialplus-asr \
    && /opt/socialplus-asr/bin/pip install --no-cache-dir -r engines/requirements-asr.txt -r /app/apps/worker/reconstruction/alex-v16/requirements.txt \
    && npm ci --prefix /app/apps/worker --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && /opt/socialplus-asr/bin/python scripts/download-local-model.py /opt/socialplus-models/whisper-small \
    && echo '3e305921506d8872816023e4c273e75d2419fb89b24da97b4fe7bce14170d671  /opt/socialplus-models/whisper-small/model.bin' | sha256sum -c - \
    && chmod -R a+rX /opt/socialplus-models \
    && mkdir -p /data && chown node:node /data
# Both standalone ASR and the shared Alex pipeline must use the same environment.
ENV SOCIALPLUS_PYTHON=/opt/socialplus-asr/bin/python SOCIALPLUS_ASR_PYTHON=/opt/socialplus-asr/bin/python SOCIALPLUS_ASR_MODEL_DIR=/opt/socialplus-models/whisper-small HF_HUB_OFFLINE=1
USER node
ENV NODE_ENV=production SOCIALPLUS_HOST=0.0.0.0 PORT=4318 SOCIALPLUS_DATA_DIR=/data
EXPOSE 4318
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "npm run preflight && exec npm start"]
