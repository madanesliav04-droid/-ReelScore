# PRIVATE runtime settings — must target the isolated beta backend only.
SUPABASE_URL=https://ISOLATED_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INJECT_PRIVATE_ISOLATED_SERVICE_KEY
# Edge function settings:
ALLOWED_ORIGIN=https://EXACT_PREVIEW_HOST.vercel.app
ALEX_V16_RECONSTRUCTION_ENABLED=true
# Worker settings; Docker build ARG: ENABLE_ALEX_OFFLINE=1
ALEX_V16_REVIEW_DRAFTS=true
SOCIALPLUS_ASR_MODEL_DIR=/private/models/whisper-small
SOCIALPLUS_PYTHON=/opt/socialplus-asr/bin/python
WORKER_ID=socialplus-alex-private-beta
POLL_MS=2500
# Configure exactly one replica. Polling is not itself a per-user usage quota.
# Current worker startup also requires GEMINI_API_KEY even for the offline Alex
# branch. Do not inject a production/paid key just to satisfy startup: isolate
# this prerequisite and enforce offline/Alex-only admission before activation.
