# Isolated Supabase Edge secrets AND Railway worker variables:
SUPABASE_URL=https://ISOLATED_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=INJECT_PRIVATE_ISOLATED_SERVICE_KEY
SOCIALPLUS_ALEX_ONLY=true
ALEX_V16_RECONSTRUCTION_ENABLED=true
# Edge only: set to the exact HTTPS deployment origin, not a wildcard.
ALLOWED_ORIGIN=https://EXACT_PREVIEW_HOST.vercel.app
# Worker image deploy/socialplus-beta/Dockerfile sets these as well:
ALEX_V16_REVIEW_DRAFTS=true
SOCIALPLUS_ASR_MODEL_DIR=/opt/models/whisper-small
SOCIALPLUS_PYTHON=/opt/socialplus-asr/bin/python
WORKER_ID=socialplus-alex-private-beta
POLL_MS=2500
# Exactly one replica. No GEMINI_API_KEY and no R2 production credentials.
